{
  "name": "dsh-dataforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 数据智造插件：声明式流程包（Flow Pack）运行器。发现流程、三道闸、后台 job 驱动外部引擎、NDJSON 进度流与证据留痕。DataForge Loop 是第一个内置流程包。",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && pnpm build:client",
    "build:client": "tsdown -c tsdown.client.config.mjs && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run --passWithNoTests"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^4.1.0",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  }
}
