{
  "name": "dsh-dataforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: turn captured web traffic into executable, versioned interface-chains — trace analysis, chain drafting, binding, probe, run, verify and evidence export. TypeScript-only, HTTP-only execution core.",
  "license": "MIT",
  "author": "kakaCat",
  "homepage": "https://github.com/kakaCat/dsh-dataforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakaCat/dsh-dataforge.git"
  },
  "bugs": {
    "url": "https://github.com/kakaCat/dsh-dataforge/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "api-testing",
    "test-data",
    "http",
    "interface-chain",
    "trace-analysis"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && pnpm build:client",
    "build:client": "tsdown -c tsdown.client.config.mjs && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test-client.json",
    "test": "vitest run --passWithNoTests",
    "gen:xyflow-css": "node scripts/gen-xyflow-css.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^4.1.0",
    "playwright-core": "^1.64.1"
  },
  "peerDependencies": {
    "dsh-builtin-browser": ">=0.4.13 <0.5.0"
  },
  "peerDependenciesMeta": {
    "dsh-builtin-browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  }
}
